# realtimevoice environment example — copy and fill real values OUTSIDE the repo.
# No hosts, keys or model IDs are defaulted in tracked code.

# Instance access token (browser + API clients). If unset, a random token is
# generated on first start and stored privately in the data dir (server.json).
REALTIMEVOICE_AUTH_TOKEN=

# Runtime state directory: settings.json (backends incl. credentials) and
# server.json (instance token), both 0600. Keep this outside version control.
REALTIMEVOICE_DATA_DIR=
