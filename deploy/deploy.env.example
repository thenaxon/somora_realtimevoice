# realtimevoice deployment environment — copy to deploy/deploy.env and fill in.
# Never commit the filled file. All values are host-specific and required
# unless a default is shown.

# Image tag produced by deploy/build-image.sh (short commit sha), applied to
# the somora-realtimevoice repository.
RTV_IMAGE_TAG=

# LAN address the app binds to (explicit; never 0.0.0.0). Example: 192.0.2.10
RTV_BIND_ADDR=

# Host runtime data directory (settings.json, server.json, voices/).
# Example: /srv/realtimevoice/data
RTV_DATA_DIR=

# Published HTTP port on the host (default 8766).
RTV_HTTP_PORT=8766

# TLS terminator settings (only used with `--profile tls`).
RTV_HTTPS_PORT=8444
# Publicly trusted hostname served over HTTPS. In production this is resolved
# only by internal DNS to the LAN address (no public A record).
RTV_TLS_HOSTNAME=
# TLS mode: `files` (operator-provided PEM pair) or `dns-cloudflare`
# (automatic Let's Encrypt DNS-01 via the Cloudflare plugin).
RTV_TLS_MODE=files
# Image for the TLS terminator. For `files` use a digest-pinned stock Caddy,
# e.g. caddy:2.10.0-alpine@sha256:<digest>. For `dns-cloudflare` use the
# xcaddy-built image from deploy/build-tls-image.sh, e.g.
# somora-realtimevoice-tls:2.10.0
RTV_TLS_IMAGE=
# Host directory holding TLS state: ./certs (PEM pair, 0600) and ./caddy-data
# (ACME storage), plus an optional ./cloudflare.env (0600) with CF_API_TOKEN.
# Example: /srv/realtimevoice/tls
RTV_TLS_DIR=
# ACME contact e-mail (dns-cloudflare mode).
RTV_ACME_EMAIL=
# Certificate expiry warning threshold in days for deploy/check-cert.sh.
RTV_CERT_MIN_DAYS=21

# Instance access token. Leave empty to generate one privately in server.json
# on first start (recommended); set it to pin a fixed token.
REALTIMEVOICE_AUTH_TOKEN=

# Backup retention window in days (default 30). Only this tool's own backups
# inside the backup directory are ever pruned.
RTV_BACKUP_KEEP_DAYS=30
